---
/**
 * I segnavia della Via: il cammino segue sentieri esistenti, ognuno con la
 * propria segnaletica. Qui tre esempi illustrati di quelle che si incontrano:
 * la bandierina bianco-rossa CAI, il «pallino giallo pieno» e i
 * «due cerchi rossi vuoti» FIE.
 */
interface Props {
  larghezza?: number;
}
const { larghezza = 320 } = Astro.props;
---

<svg
  width={larghezza}
  viewBox="0 0 320 110"
  role="img"
  aria-label="Tre segnavia della Via: bandierina bianco-rossa CAI 177, pallino giallo pieno, due cerchi rossi vuoti"
>
  <!-- Tre pietre -->
  <g fill="var(--pietra-chiara)" opacity="0.5">
    <path d="M8 78 Q 4 50 22 40 Q 40 26 66 30 Q 94 34 98 56 Q 102 76 84 86 Q 56 98 28 92 Q 12 88 8 78 Z" />
    <path d="M118 78 Q 114 50 132 40 Q 150 26 176 30 Q 204 34 208 56 Q 212 76 194 86 Q 166 98 138 92 Q 122 88 118 78 Z" />
    <path d="M228 78 Q 224 50 242 40 Q 260 26 286 30 Q 314 34 318 56 Q 322 76 304 86 Q 276 98 248 92 Q 232 88 228 78 Z" />
  </g>

  <!-- Bandierina bianco-rossa CAI con numero -->
  <g transform="translate(24 42)">
    <rect x="0" y="0" width="58" height="11" fill="#c4452e" rx="1.5"></rect>
    <rect x="0" y="11" width="58" height="11" fill="#f6f1e6"></rect>
    <rect x="0" y="22" width="58" height="11" fill="#c4452e" rx="1.5"></rect>
    <text
      x="29"
      y="20"
      text-anchor="middle"
      font-family="var(--sans)"
      font-size="10"
      font-weight="700"
      fill="#3d3a33">177</text
    >
  </g>

  <!-- Pallino giallo pieno -->
  <circle cx="163" cy="60" r="16" fill="#d9a916"></circle>

  <!-- Due cerchi rossi vuoti (FIE) -->
  <g stroke="#c4452e" stroke-width="5" fill="none">
    <circle cx="256" cy="60" r="13"></circle>
    <circle cx="290" cy="60" r="13"></circle>
  </g>
</svg>
