    border-color: var(--terra);
    background: var(--terra-fondo);
  }
  .planner__servizio svg { flex: none; }
</style>

<script>
  interface TappaDati {
    nome: string;
    da: string;
    a: string;
    distanzaKm: number;
    salitaM: number;
    discesaM: number;
    oreBase: number;
    segnavia: string;
    punti: string[];
    passi: { titolo: string; testo: string }[];
  }

  // Acqua e appoggi presenti in un singolo step (riconosciuti dal testo).
  interface Servizi {
    acqua: string[];
    appoggi: string[];
  }

  const sezione = document.querySelector<HTMLElement>('.planner');

  if (sezione) {
    const dati = JSON.parse(
      sezione.querySelector('[data-dati-planner]')!.textContent!
    ) as {
      itinerari: {
        id: string;
        nome: string;
        difficolta: string;
        segnavia: string;
        giorniConsigliati: string;
        anello: boolean;
        tappe: string[];
      }[];
      tappe: Record<string, TappaDati>;
      punti: Record<
        string,
        {
          nome: string;
          acquaPotabile: boolean;
          appoggio: boolean;
          quota: number | null;
        }
      >;
    };

    const campo = {
      itinerario: sezione.querySelector<HTMLSelectElement>('#pl-itinerario')!,
      partenza: sezione.querySelector<HTMLSelectElement>('#pl-partenza')!,
      arrivo: sezione.querySelector<HTMLSelectElement>('#pl-arrivo')!,
      senso: sezione.querySelector<HTMLSelectElement>('#pl-senso')!,
      passo: sezione.querySelector<HTMLSelectElement>('#pl-passo')!,
      tempo: sezione.querySelector<HTMLSelectElement>('#pl-tempo')!,
    };

    const esito = (nome: string) =>
      sezione.querySelector<HTMLElement>(`[data-esito="${nome}"]`)!;

    const ETICHETTA_DIFFICOLTA: Record<string, string> = {
      facile: 'Facile',
      medio: 'Medio',
      impegnativo: 'Impegnativo',
    };

    function formattaOre(ore: number): string {
      const h = Math.floor(ore);
      const min = Math.round((ore - h) * 60);
      if (h === 0) return `${min} min`;
      return min === 0 ? `${h} h` : `${h} h ${min} min`;
    }

    function itinerarioScelto() {
      return dati.itinerari.find((i) => i.id === campo.itinerario.value)!;
    }

    /** Le tappe del tratto scelto, nell'ordine in cui verranno camminate. */
    function tappeScelte(): TappaDati[] {
      const itinerario = itinerarioScelto();
      const da = Number(campo.partenza.value);
      const a = Number(campo.arrivo.value);
      const ids = itinerario.tappe.slice(da, a + 1);
      const tappe = ids.map((id) => dati.tappe[id]);
      return campo.senso.value === 'inverso' ? [...tappe].reverse() : tappe;
    }

    /** Ripopola le tendine «Parti da» / «Arrivi a» per l'itinerario scelto. */
    function aggiornaTratto() {
      const itinerario = itinerarioScelto();
      const tappe = itinerario.tappe.map((id) => dati.tappe[id]);

      campo.partenza.innerHTML = '';
      tappe.forEach((tappa, i) => {
        campo.partenza.add(new Option(tappa.da, String(i)));
      });
      campo.partenza.value = '0';
      aggiornaArrivo();
    }

    function aggiornaArrivo() {
      const itinerario = itinerarioScelto();
      const tappe = itinerario.tappe.map((id) => dati.tappe[id]);
      const da = Number(campo.partenza.value);
      const precedente = campo.arrivo.value;

      campo.arrivo.innerHTML = '';
      tappe.forEach((tappa, i) => {
        if (i >= da) campo.arrivo.add(new Option(tappa.a, String(i)));
      });
      campo.arrivo.value =
        [...campo.arrivo.options].some((o) => o.value === precedente)
          ? precedente
          : String(tappe.length - 1);
    }

    // --- Stepper delle tappe ---------------------------------------------
    let passi: {
      tappa: string;
      titolo: string;
      testo: string;
      punti: string[];
    }[] = [];
    let passoCorrente = 0;
    let htmlPiano = ''; // il piano corrente in HTML, pronto da stampare in PDF
    let titoloPiano = 'Piano di cammino';

    const bottoneIndietro = sezione.querySelector<HTMLButtonElement>('[data-azione="indietro"]')!;
    const bottoneAvanti = sezione.querySelector<HTMLButtonElement>('[data-azione="avanti"]')!;

    /** Nome «corto» di un punto, per riconoscerlo anche dove il testo lo cita
     *  senza il suffisso (es. «Ruta» per «Ruta di Camogli»). */
    function nomeCorto(nome: string): string {
      return nome.split(/ (?:di|in|del|della|dei|mare)\b/i)[0].trim();
    }

    /** Acqua e appoggi citati in uno step (cercati tra i punti della tratta). */
    function serviziDiPasso(passo: { testo: string; titolo: string; punti: string[] }): Servizi {
      const testo = `${passo.titolo} ${passo.testo}`.toLowerCase();
      const acqua: string[] = [];
      const appoggi: string[] = [];
      for (const id of passo.punti) {
        const p = dati.punti[id];
        if (!p) continue;
        const nome = p.nome.toLowerCase();
        const corto = nomeCorto(p.nome).toLowerCase();
        const citato = testo.includes(nome) || (corto.length >= 4 && testo.includes(corto));
        if (!citato) continue;
        if (p.acquaPotabile) acqua.push(p.nome);
        if (p.appoggio) appoggi.push(p.nome);
      }
      return { acqua, appoggi };
    }

    const ICONA_ACQUA =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3 C 12 3 6 10.5 6 14.5 C 6 18 8.7 20.5 12 20.5 C 15.3 20.5 18 18 18 14.5 C 18 10.5 12 3 12 3 Z"></path></svg>';
    const ICONA_APPOGGIO =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 20 V11 L12 5 L20 11 V20 Z"></path><path d="M9 20 V14 H15 V20"></path></svg>';

    function mostraPasso() {
      const passo = passi[passoCorrente];
      if (!passo) return;
      esito('passo-tappa').textContent = passo.tappa;
      esito('passo-titolo').textContent = passo.titolo;
      esito('passo-testo').textContent = passo.testo;
      esito('passo-contatore').textContent =
        `Passo ${passoCorrente + 1} di ${passi.length}`;

      const servizi = serviziDiPasso(passo);
      const badge: string[] = [];
      if (servizi.acqua.length)
        badge.push(
          `<span class="planner__servizio planner__servizio--acqua">${ICONA_ACQUA} Acqua: ${servizi.acqua.join(', ')}</span>`
        );
      if (servizi.appoggi.length)
        badge.push(
          `<span class="planner__servizio planner__servizio--appoggio">${ICONA_APPOGGIO} Punto d’appoggio: ${servizi.appoggi.join(', ')}</span>`
        );
      esito('passo-servizi').innerHTML = badge.join('');

      bottoneIndietro.disabled = passoCorrente === 0;
      bottoneAvanti.disabled = passoCorrente === passi.length - 1;
    }

    bottoneIndietro.addEventListener('click', () => {
      if (passoCorrente > 0) {
        passoCorrente--;
        mostraPasso();
      }
    });
    bottoneAvanti.addEventListener('click', () => {
      if (passoCorrente < passi.length - 1) {
        passoCorrente++;
        mostraPasso();
      }
    });

    // --- Calcolo del piano -------------------------------------------------
    function calcola() {
      const itinerario = itinerarioScelto();
      const tappe = tappeScelte();
      const inverso = campo.senso.value === 'inverso';
      const fattore = Number(campo.passo.value);
      const orePerGiorno = Number(campo.tempo.value);

      const distanza = tappe.reduce((s, t) => s + t.distanzaKm, 0);
      const salita = tappe.reduce((s, t) => s + (inverso ? t.discesaM : t.salitaM), 0);
      const discesa = tappe.reduce((s, t) => s + (inverso ? t.salitaM : t.discesaM), 0);
      const ore = tappe.reduce((s, t) => s + t.oreBase, 0) * fattore;

      esito('distanza').textContent = `${distanza.toLocaleString('it-IT', { maximumFractionDigits: 1 })} km`;
      esito('salita').textContent = `${salita} m`;
      esito('discesa').textContent = `${discesa} m`;
      esito('tempo').textContent = formattaOre(ore);
      esito('difficolta').textContent = ETICHETTA_DIFFICOLTA[itinerario.difficolta];
      esito('segnavia').innerHTML = tappe
        .map((t) => {
          const tratto = inverso ? `${t.a} → ${t.da}` : `${t.da} → ${t.a}`;
          return `<li><strong>${tratto}:</strong> ${t.segnavia}</li>`;
        })
        .join('');

      const prima = tappe[0];
      const ultima = tappe[tappe.length - 1];
      const partenza = inverso ? prima.a : prima.da;
      const arrivo = inverso ? ultima.da : ultima.a;
      esito('direzione').textContent = itinerario.anello
        ? `Anello con partenza e ritorno a ${partenza}. Il tempo stimato non comprende le soste.`
        : `Da ${partenza} a ${arrivo}, in senso ${inverso ? 'inverso' : 'classico'}. Il tempo stimato non comprende le soste.`;

      // Suddivisione in giornate, rispettando le ore disponibili al giorno.
      const giornate: { tappe: TappaDati[]; ore: number }[] = [];
      let giornataLunga = false;
      for (const tappa of tappe) {
        const oreTappa = tappa.oreBase * fattore;
        const corrente = giornate[giornate.length - 1];
        if (corrente && corrente.ore + oreTappa <= orePerGiorno) {
          corrente.tappe.push(tappa);
          corrente.ore += oreTappa;
        } else {
          giornate.push({ tappe: [tappa], ore: oreTappa });
          if (oreTappa > orePerGiorno) giornataLunga = true;
        }
      }

      const blocchoGiornate = esito('giornate');
      if (giornate.length > 1) {
        const voci = giornate
          .map((giornata, i) => {
            const g0 = giornata.tappe[0];
            const g1 = giornata.tappe[giornata.tappe.length - 1];
            const da = inverso ? g0.a : g0.da;
            const a = inverso ? g1.da : g1.a;
            return `<li><strong>Giorno ${i + 1}:</strong> da ${da} a ${a} (${formattaOre(giornata.ore)})</li>`;
          })
          .join('');
        blocchoGiornate.innerHTML = `<ol class="planner__giornate">${voci}</ol>`;
      } else {
        blocchoGiornate.innerHTML = '';
      }

      const avviso = esito('avviso');
      if (giornataLunga) {
        avviso.innerHTML =
          '<p><strong>Giornata lunga per il tempo che hai indicato.</strong> Parti presto al mattino, oppure scegli un tratto più corto o un passo più realistico: la Via resta lì, non scappa.</p>';
        avviso.hidden = false;
      } else if (giornate.length > 1) {
        avviso.innerHTML = `<p><strong>Servono ${giornate.length} giorni con le ore che hai a disposizione.</strong> Le notti si organizzano nei <a href="/itinerario#appoggio">punti d’appoggio</a> lungo la Via.</p>`;
        avviso.hidden = false;
      } else {
        avviso.hidden = true;
      }

      // Acqua lungo il tratto, nell'ordine in cui la incontri.
      const vistiAcqua = new Set<string>();
      const acquaNomi: string[] = [];
      for (const tappa of tappe) {
        const puntiTappa = inverso ? [...tappa.punti].reverse() : tappa.punti;
        for (const id of puntiTappa) {
          const punto = dati.punti[id];
          if (punto?.acquaPotabile && !vistiAcqua.has(id)) {
            vistiAcqua.add(id);
            acquaNomi.push(punto.nome);
          }
        }
      }

      // Zaino: base + aggiunte legate a durata, quota e difficoltà.
      // Non mostrato qui (sta in «Informazioni pratiche»): serve solo al PDF.
      const zaino = [
        'Scarpe da trekking già rodate',
        'Borraccia da almeno 1 litro',
        'Guscio antipioggia',
        'Cappello e crema solare',
        'Telefono carico (e mappa scaricata: sul sentiero il campo va e viene)',
        'Qualcosa da mangiare lungo il cammino',
      ];
      if (ore > 4) zaino.splice(2, 0, 'Scorta d’acqua: almeno 1,5 litri a persona');
      if (tappe.some((t) => t.punti.some((id) => (dati.punti[id]?.quota ?? 0) >= 1000)))
        zaino.push('Uno strato caldo in più: i crinali sopra i mille metri sono ventosi anche d’estate');
      if (itinerario.difficolta === 'impegnativo')
        zaino.push('Bastoncini da trekking per le lunghe discese');
      if (giornate.length > 1)
        zaino.push('Sacco lenzuolo e un ricambio per le notti nei punti d’appoggio');

      // Stepper.
      esito('nota-inverso').hidden = !inverso;
      passi = tappe.flatMap((tappa) => {
        const passiTappa = inverso ? [...tappa.passi].reverse() : tappa.passi;
        return passiTappa.map((passo) => ({
          tappa: tappa.nome,
          titolo: passo.titolo,
          testo: passo.testo,
          punti: tappa.punti,
        }));
      });
      passoCorrente = 0;
      mostraPasso();

      // Prepara il piano completo in HTML, pronto da stampare/salvare in PDF.
      const senso = inverso ? 'inverso' : 'classico';
      const esc = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      titoloPiano = `${itinerario.nome} (${itinerario.anello ? partenza : partenza + ' › ' + arrivo})`;

      const h: string[] = [];
      h.push(`<h1>L’Antica Via del Cifalco</h1>`);
      h.push(`<p class="sottotitolo">Piano di cammino: <strong>${esc(itinerario.nome)}</strong></p>`);
      h.push(
        `<p>${
          itinerario.anello
            ? `Anello con partenza e ritorno a ${esc(partenza)}.`
            : `Da ${esc(partenza)} a ${esc(arrivo)} (senso ${senso}).`
        }</p>`
      );
      h.push('<h2>In sintesi</h2><ul>');
      h.push(`<li>Distanza stimata: ${distanza.toLocaleString('it-IT', { maximumFractionDigits: 1 })} km</li>`);
      h.push(`<li>Salita: ${salita} m &nbsp;·&nbsp; Discesa: ${discesa} m</li>`);
      h.push(`<li>Tempo di cammino (soste escluse): ${formattaOre(ore)}</li>`);
      h.push(`<li>Difficoltà: ${ETICHETTA_DIFFICOLTA[itinerario.difficolta]}</li>`);
      h.push('</ul>');

      h.push('<h2>Segnavia, tratta per tratta</h2><ul>');
      tappe.forEach((t) => {
        const tratto = inverso ? `${t.a} › ${t.da}` : `${t.da} › ${t.a}`;
        h.push(`<li><strong>${esc(tratto)}:</strong> ${esc(t.segnavia)}</li>`);
      });
      h.push('</ul>');

      if (giornate.length > 1) {
        h.push('<h2>Suddivisione in giornate</h2><ol>');
        giornate.forEach((g) => {
          const da = inverso ? g.tappe[0].a : g.tappe[0].da;
          const a = inverso ? g.tappe[g.tappe.length - 1].da : g.tappe[g.tappe.length - 1].a;
          h.push(`<li>Da ${esc(da)} a ${esc(a)} (${formattaOre(g.ore)})</li>`);
        });
        h.push('</ol>');
      }

      h.push('<h2>Acqua lungo il tratto</h2><ul>');
      if (acquaNomi.length) acquaNomi.forEach((n) => h.push(`<li>${esc(n)}</li>`));
      else h.push('<li>Nessuna fonte: parti con tutta l’acqua che ti serve.</li>');
      h.push('</ul>');

      h.push('<h2>Cosa portare</h2><ul>');
      zaino.forEach((v) => h.push(`<li>${esc(v)}</li>`));
      h.push('</ul>');

      h.push('<h2>Le tappe, passo per passo</h2>');
      let tappaTitoloPrec = '';
      passi.forEach((p) => {
        if (p.tappa !== tappaTitoloPrec) {
          h.push(`<h3>${esc(p.tappa)}</h3>`);
          tappaTitoloPrec = p.tappa;
        }
        h.push(`<p class="passo"><strong>${esc(p.titolo)}.</strong> ${esc(p.testo)}</p>`);
        const s = serviziDiPasso(p);
        const note: string[] = [];
        if (s.acqua.length) note.push(`Acqua: ${s.acqua.join(', ')}`);
        if (s.appoggi.length) note.push(`Punto d’appoggio: ${s.appoggi.join(', ')}`);
        if (note.length) h.push(`<p class="servizi">${esc(note.join(' · '))}</p>`);
      });
      if (inverso) {
        h.push(
          '<p class="nb">Le indicazioni passo per passo sono descritte nel senso classico; in senso inverso usale come riferimento dei luoghi, in ordine contrario.</p>'
        );
      }
      h.push('<p class="chiusura">Buon cammino. La montagna chiede rispetto, non coraggio.<br>anticaviadelcifalco.it</p>');
      htmlPiano = h.join('\n');

      // Dillo anche alla mappa, se c'è. Il rinvio di un tick garantisce che
      // al primo calcolo lo script della mappa abbia già registrato l'ascolto.
      setTimeout(() =>
        window.dispatchEvent(
          new CustomEvent('via-cifalco:itinerario', {
            detail: { id: itinerario.id },
          })
        )
      );
    }

    campo.itinerario.addEventListener('change', () => {
      aggiornaTratto();
      calcola();
    });
    campo.partenza.addEventListener('change', () => {
      aggiornaArrivo();
      calcola();
    });
    [campo.arrivo, campo.senso, campo.passo, campo.tempo].forEach((select) =>
      select.addEventListener('change', calcola)
    );

    // Scarica il piano in PDF: apre una pagina pulita e la finestra di stampa,
    // dove il browser permette di «Salvare come PDF» (funziona anche da telefono).
    const stiliStampa = `
      @page { margin: 18mm; }
      body { font-family: Georgia, 'Times New Roman', serif; color: #2E332C; line-height: 1.5; max-width: 40rem; margin: 0 auto; padding: 1rem; }
      h1 { font-size: 1.5rem; margin: 0 0 0.2rem; }
      .sottotitolo { margin: 0 0 1rem; color: #54594E; }
      h2 { font-size: 1.15rem; margin: 1.4rem 0 0.4rem; border-bottom: 2px solid #8A9A7B; padding-bottom: 0.15rem; }
      h3 { font-size: 1rem; margin: 1rem 0 0.3rem; color: #4A5D44; }
      ul, ol { margin: 0.3rem 0 0.6rem 1.2rem; padding: 0; }
      li { margin-bottom: 0.2rem; }
      .passo { margin: 0.2rem 0 0.2rem; }
      .servizi { margin: 0 0 0.5rem; font-size: 0.9rem; color: #455F60; font-weight: bold; }
      .nb, .chiusura { color: #54594E; font-size: 0.95rem; }
      .chiusura { margin-top: 1.5rem; border-top: 1px solid #A9B49B; padding-top: 0.6rem; }
    `;
    sezione
      .querySelector<HTMLButtonElement>('[data-azione="scarica"]')!
      .addEventListener('click', () => {
        const w = window.open('', '_blank');
        if (!w) return;
        w.document.write(
          `<!doctype html><html lang="it"><head><meta charset="utf-8">` +
            `<title>${titoloPiano}</title><style>${stiliStampa}</style></head>` +
            `<body>${htmlPiano}</body></html>`
        );
        w.document.close();
        w.focus();
        // Lascia un attimo al rendering, poi apre la stampa.
        w.setTimeout(() => w.print(), 350);
      });

    aggiornaTratto();
    calcola();
  }
</script>
