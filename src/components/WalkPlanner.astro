  .planner__titolo {
    margin-bottom: 0.2rem;
  }

  .planner__intestazione {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
