  .planner__dati {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin: 0 0 1rem;
  }

  .planner__segnavia {
    margin-bottom: 0.4rem;
  }

  .planner__segnavia ul {
    margin: 0.3rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.95rem;
  }

  .planner__segnavia li {
    margin-bottom: 0.25rem;
  }

