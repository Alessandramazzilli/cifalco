---
/**
 * Il walk planner: scegli itinerario, tratto, senso, passo e tempo,
 * e ottieni un piano chiaro con tappe passo-passo.
 * È un'isola autonoma: i dati arrivano dalle content collection e vengono
 * serializzati qui sotto; la mappa viene aggiornata via evento
 * «via-cifalco:itinerario».
 */
import { caricaPercorso } from '../lib/percorso';

const percorso = await caricaPercorso();

const datiPlanner = {
  itinerari: percorso.itinerari.map((i) => ({
    id: i.id,
    nome: i.nome,
    difficolta: i.difficolta,
    giorniConsigliati: i.giorniConsigliati,
    anello: i.anello,
    tappe: i.tappe,
  })),
  tappe: Object.fromEntries(
    percorso.tappe.map((t) => [
      t.id,
      {
        nome: t.nome,
        da: t.da,
        a: t.a,
        distanzaKm: t.distanzaKm,
        salitaM: t.salitaM,
        discesaM: t.discesaM,
        oreBase: t.oreBase,
        segnavia: t.segnavia,
        punti: t.punti,
        passi: t.passi,
      },
    ])
  ),
  punti: Object.fromEntries(
    percorso.punti.map((p) => [
      p.id,
      {
        nome: p.nome,
        acquaPotabile: p.acquaPotabile,
        appoggio: p.appoggio,
        quota: p.quota ?? null,
      },
    ])
  ),
};
---

<section class="planner" aria-label="Pianifica la tua camminata">
  <form class="planner__modulo card">
    <h3 class="planner__titolo">Costruisci il tuo piano</h3>
    <p class="planner__sottotitolo">
      Cinque scelte, nessun calcolo da fare: al resto pensiamo noi.
    </p>

    <div class="planner__campi">
      <div class="planner__campo planner__campo--largo">
        <label for="pl-itinerario">Itinerario</label>
        <select id="pl-itinerario" name="itinerario">
          {
            percorso.itinerari.map((i) => (
              <option value={i.id}>
                {i.nome}, {i.sottotitolo.toLowerCase()}
              </option>
            ))
          }
        </select>
      </div>

      <div class="planner__campo">
        <label for="pl-partenza">Parti da</label>
        <select id="pl-partenza" name="partenza"></select>
      </div>

      <div class="planner__campo">
        <label for="pl-arrivo">Arrivi a</label>
        <select id="pl-arrivo" name="arrivo"></select>
      </div>

      <div class="planner__campo">
        <label for="pl-senso">Senso di percorrenza</label>
        <select id="pl-senso" name="senso">
          <option value="classico">Classico (verso Portofino)</option>
          <option value="inverso">Inverso</option>
        </select>
      </div>

      <div class="planner__campo">
        <label for="pl-passo">Il tuo passo</label>
        <select id="pl-passo" name="passo">
          <option value="1.25">Tranquillo, prime uscite, famiglie</option>
          <option value="1" selected>Medio, cammino abitualmente</option>
          <option value="0.85">Allenato, montagna frequente</option>
        </select>
      </div>

      <div class="planner__campo">
        <label for="pl-tempo">Ore di cammino al giorno</label>
        <select id="pl-tempo" name="tempo">
          <option value="4">Fino a 4 ore</option>
          <option value="6" selected>Fino a 6 ore</option>
          <option value="8">Fino a 8 ore</option>
        </select>
      </div>
    </div>
  </form>

  <div class="planner__risultato">
    <div class="planner__intestazione">
      <h3>Il tuo piano</h3>
      <button type="button" class="bottone bottone--contorno planner__scarica" data-azione="scarica">
        Scarica il piano (PDF)
      </button>
    </div>

    <dl class="planner__dati">
      <div class="dato"><dt>Distanza</dt><dd data-esito="distanza"></dd></div>
      <div class="dato"><dt>Salita</dt><dd data-esito="salita"></dd></div>
      <div class="dato"><dt>Discesa</dt><dd data-esito="discesa"></dd></div>
      <div class="dato"><dt>Tempo stimato</dt><dd data-esito="tempo"></dd></div>
      <div class="dato"><dt>Difficoltà</dt><dd data-esito="difficolta"></dd></div>
    </dl>

    <div class="planner__segnavia">
      <strong>Segnavia da seguire, tratta per tratta:</strong>
      <ul data-esito="segnavia"></ul>
    </div>

    <p class="planner__direzione" data-esito="direzione"></p>

    <div class="planner__avviso" data-esito="avviso" role="status" hidden></div>

    <div data-esito="giornate"></div>

    <section class="planner__tappe" aria-label="Le tappe in sequenza">
      <h4>Le tappe, una alla volta</h4>
      <p class="planner__nota-inverso" data-esito="nota-inverso" hidden>
        Le indicazioni sono descritte nel senso classico: in senso inverso
        usale come riferimento dei luoghi che attraversi, in ordine contrario.
      </p>
      <article class="planner__passo card" aria-live="polite">
        <p class="occhiello" data-esito="passo-tappa"></p>
        <h5 data-esito="passo-titolo"></h5>
        <p data-esito="passo-testo"></p>
        <div class="planner__servizi" data-esito="passo-servizi"></div>
      </article>
      <div class="planner__navigazione">
        <button type="button" class="bottone bottone--contorno" data-azione="indietro">
          ← Indietro
        </button>
        <span class="planner__contatore" data-esito="passo-contatore"></span>
        <button type="button" class="bottone bottone--pieno" data-azione="avanti">
          Avanti →
        </button>
      </div>
    </section>
  </div>

  <script type="application/json" data-dati-planner set:html={JSON.stringify(datiPlanner)} />
</section>

<style>
  .planner {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
  }

  @media (max-width: 56rem) {
    .planner {
      grid-template-columns: 1fr;
    }
  }

  .planner__titolo {
    margin-bottom: 0.2rem;
  }

  .planner__intestazione {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
