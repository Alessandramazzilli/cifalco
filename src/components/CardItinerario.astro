---
import type { Itinerario, Percorso } from '../lib/percorso';
import { formattaOre } from '../lib/percorso';

interface Props {
  itinerario: Itinerario;
  percorso: Percorso;
}
const { itinerario, percorso } = Astro.props;

const tappe = itinerario.tappe.map(
  (id) => percorso.tappe.find((t) => t.id === id)!
);
const distanza = tappe.reduce((s, t) => s + t.distanzaKm, 0);
const salita = tappe.reduce((s, t) => s + t.salitaM, 0);
const ore = tappe.reduce((s, t) => s + t.oreBase, 0);

const ETICHETTA_DIFFICOLTA = {
  facile: 'Facile',
  medio: 'Medio',
  impegnativo: 'Impegnativo',
} as const;
---

<article class="card itinerario">
  <p class="occhiello">{itinerario.giorniConsigliati}</p>
  <h3>{itinerario.nome}</h3>
  <p class="itinerario__sottotitolo">{itinerario.sottotitolo}</p>
  <p>{itinerario.descrizione}</p>
  <dl class="itinerario__dati">
    <div class="dato">
      <dt>Distanza</dt>
      <dd>{distanza.toLocaleString('it-IT', { maximumFractionDigits: 1 })} km</dd>
    </div>
    <div class="dato">
      <dt>Salita</dt>
      <dd>{salita} m</dd>
    </div>
    <div class="dato">
      <dt>Tempo</dt>
      <dd>{formattaOre(ore)}</dd>
    </div>
  </dl>
  <p>
    <span class:list={['etichetta', `etichetta--${itinerario.difficolta}`]}>
      {ETICHETTA_DIFFICOLTA[itinerario.difficolta]}
    </span>
  </p>
  <a class="bottone bottone--contorno" href="/itinerario#pianifica">
    Pianifica questo itinerario
  </a>
</article>

<style>
  .itinerario {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .itinerario__sottotitolo {
    font-family: var(--serif);
    font-style: italic;
    color: var(--umbra);
    margin-bottom: 0.6rem;
  }

  .itinerario__dati {
    display: flex;
    gap: 1.5rem;
    margin: 0.25rem 0 0.75rem;
  }

  .itinerario__dati dd {
    font-size: 1.15rem;
  }

  .itinerario .bottone {
    margin-top: auto;
    font-size: 0.95rem;
  }
</style>
