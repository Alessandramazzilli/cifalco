---
/**
 * Foto reale, mostrata SEMPRE per intero (nessun ritaglio).
 * L'immagine mantiene le sue proporzioni naturali; sta dentro la colonna in
 * cui la metti. Le immagini stanno in public/immagini/ (vedi README).
 */
interface Props {
  src: string; // es. "/immagini/portofino-baia.jpg"
  alt: string;
  didascalia?: string;
  classe?: string;
}
const { src, alt, didascalia, classe } = Astro.props;
---

<figure class:list={['foto', classe]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {didascalia && <figcaption>{didascalia}</figcaption>}
</figure>

<style>
  .foto {
    margin: 0;
  }
  .foto img {
    display: block;
    width: 100%;
    height: auto; /* proporzioni naturali: l'immagine non viene mai tagliata */
    border-radius: var(--raggio-grande);
    box-shadow: var(--ombra);
  }
  .foto figcaption {
    font-size: 0.85rem;
    color: var(--inchiostro-tenue);
    padding: 0.5rem 0.2rem 0;
  }
</style>
