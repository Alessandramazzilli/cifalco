---
/**
 * Foto reale. Le immagini stanno in public/immagini/ (vedi README).
 * Il rapporto predefinito è 3/2, lo stesso delle foto: così non vengono
 * tagliate. Usa `posizione` per spostare il punto messo a fuoco nel ritaglio.
 */
interface Props {
  src: string; // es. "/immagini/panorama-cifalco.jpg"
  alt: string;
  rapporto?: string; // es. "3/2", "16/9", "4/3"
  posizione?: string; // object-position, es. "center", "left top"
  didascalia?: string;
  classe?: string;
}
const {
  src,
  alt,
  rapporto = '3/2',
  posizione = 'center',
  didascalia,
  classe,
} = Astro.props;
---

<figure class:list={['foto', classe]}>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    style={`aspect-ratio: ${rapporto}; object-position: ${posizione};`}
  />
  {didascalia && <figcaption>{didascalia}</figcaption>}
</figure>

<style>
  .foto {
    margin: 0;
    border-radius: var(--raggio-grande);
    overflow: hidden;
    box-shadow: var(--ombra);
  }
  .foto img {
    display: block;
    width: 100%;
    object-fit: cover;
  }
  .foto figcaption {
    font-size: 0.85rem;
    color: var(--inchiostro-tenue);
    padding: 0.5rem 0.2rem 0;
  }
</style>
