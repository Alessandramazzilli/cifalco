---
// Voci del menu. Le voci con `figli` mostrano una tendina (hover/focus su
// desktop; sotto-elenco rientrato quando il menu mobile è aperto).
const voci = [
  { href: '/progetto', testo: 'Il progetto' },
  {
    href: '/itinerario',
    testo: 'L’itinerario',
    figli: [
      { href: '/itinerario/descrizione-dettagliata', testo: 'Descrizione dettagliata' },
      { href: '/itinerario/informazioni-pratiche', testo: 'Informazioni pratiche' },
    ],
  },
  { href: '/approfondimenti', testo: 'Approfondimenti' },
  { href: '/contatti', testo: 'Contatti' },
];

const percorsoAttuale = Astro.url.pathname.replace(/\/$/, '') || '/';
const attiva = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  return percorsoAttuale === base || percorsoAttuale.startsWith(base + '/');
};
---

<header class="testata">
  <div class="contenitore testata__riga">
    <a class="testata__marchio" href="/">
      <img
        src="/immagini/logo-avc.png"
        alt=""
        aria-hidden="true"
        class="testata__logo"
      />
      <span class="testata__nome">
        L’Antica Via <em>del Cifalco</em>
      </span>
    </a>

    <button
      class="testata__bottone-menu"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principale"
    >
      <span aria-hidden="true" class="testata__icona-menu"></span>
      Menu
    </button>

    <nav aria-label="Navigazione principale">
      <ul id="menu-principale" class="testata__menu">
        {
          voci.map((voce) => (
            <li class:list={['testata__voce', voce.figli && 'has-sub']}>
              <a
                href={voce.href}
                aria-current={percorsoAttuale === voce.href ? 'page' : undefined}
                class:list={[attiva(voce.href) && 'attiva']}
              >
                {voce.testo}
                {voce.figli && <span class="testata__freccia" aria-hidden="true">▾</span>}
              </a>
              {voce.figli && (
                <ul class="sottomenu">
                  {voce.figli.map((figlio) => (
                    <li>
                      <a
                        href={figlio.href}
                        aria-current={percorsoAttuale === figlio.href.split('#')[0].replace(/\/$/, '') ? 'page' : undefined}
                      >
                        {figlio.testo}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .testata {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--superficie) 94%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--sabbia);
  }

  .testata__riga {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 0.7rem;
  }

  .testata__marchio {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .testata__logo {
    height: 40px;
    width: auto;
  }

  .testata__nome {
    font-family: var(--serif);
    font-weight: 650;
    font-size: 1.15rem;
    color: var(--bosco-scuro);
    line-height: 1.1;
  }
  .testata__nome em {
    font-style: italic;
    color: var(--umbra);
  }

  .testata__bottone-menu {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-weight: 650;
    color: var(--bosco-scuro);
    background: none;
    border: 1.5px solid var(--sabbia);
    border-radius: var(--raggio);
    padding: 0.4rem 0.9rem;
    cursor: pointer;
  }

  .testata__icona-menu {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
  }

  .testata__menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .testata__menu a {
    text-decoration: none;
    font-weight: 600;
    color: var(--inchiostro-tenue);
    padding-block: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .testata__menu a:hover {
    color: var(--bosco);
  }
  .testata__menu a.attiva,
  .testata__menu a[aria-current='page'] {
    color: var(--bosco);
    box-shadow: inset 0 -2.5px 0 var(--salvia);
  }

  .testata__freccia {
    font-size: 0.7em;
    line-height: 1;
  }

  /* --- Tendina (desktop) --- */
  .has-sub {
    position: relative;
  }
  .sottomenu {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 14rem;
    background: var(--superficie);
    border: 1px solid var(--sabbia);
    border-radius: var(--raggio);
    box-shadow: var(--ombra);
    display: none;
  }
  .has-sub:hover > .sottomenu,
  .has-sub:focus-within > .sottomenu {
    display: block;
  }
  .sottomenu a {
    display: block;
    padding: 0.45rem 0.6rem;
    border-radius: var(--raggio);
    font-weight: 600;
  }
  .sottomenu a:hover {
    background: var(--fondo-scuro);
  }

  @media (max-width: 56rem) {
    .testata__bottone-menu {
      display: flex;
    }
    nav {
      width: 100%;
      order: 3;
    }
    .testata__menu {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      padding-block: 0.5rem 1rem;
      border-top: 1px solid var(--sabbia);
      margin-top: 0.5rem;
    }
    .testata__menu.aperto {
      display: flex;
    }
    .testata__menu > li > a {
      display: flex;
      padding: 0.55rem 0.25rem;
      font-size: 1.05rem;
    }
    /* Su mobile la tendina è un sotto-elenco rientrato, sempre visibile */
    .sottomenu {
      position: static;
      display: block;
      border: none;
      box-shadow: none;
      background: none;
      padding: 0 0 0.4rem 1rem;
      min-width: 0;
    }
    .sottomenu a {
      font-weight: 500;
      padding: 0.4rem 0.25rem;
    }
    .testata__freccia {
      display: none;
    }
  }
</style>

<script>
  const bottone = document.querySelector<HTMLButtonElement>('.testata__bottone-menu');
  const menu = document.getElementById('menu-principale');
  bottone?.addEventListener('click', () => {
    const aperto = menu?.classList.toggle('aperto') ?? false;
    bottone.setAttribute('aria-expanded', String(aperto));
  });
</script>
