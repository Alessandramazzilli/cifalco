---
/** Bandierina per il selettore della lingua (SVG, uguale su tutti i sistemi). */
import type { Lingua } from '../lib/i18n';
interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
---

{
  lingua === 'it' && (
    <svg width="26" height="18" viewBox="0 0 3 2" aria-hidden="true">
      <rect width="1" height="2" fill="#009246" />
      <rect x="1" width="1" height="2" fill="#fff" />
      <rect x="2" width="1" height="2" fill="#CE2B37" />
    </svg>
  )
}
{
  lingua === 'fr' && (
    <svg width="26" height="18" viewBox="0 0 3 2" aria-hidden="true">
      <rect width="1" height="2" fill="#002654" />
      <rect x="1" width="1" height="2" fill="#fff" />
      <rect x="2" width="1" height="2" fill="#CE1126" />
    </svg>
  )
}
{
  lingua === 'en' && (
    <svg width="26" height="18" viewBox="0 0 60 30" preserveAspectRatio="none" aria-hidden="true">
      <clipPath id="bandiera-uk"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
      <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#bandiera-uk)" stroke="#C8102E" stroke-width="4" />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
    </svg>
  )
}
