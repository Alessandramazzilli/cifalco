---
const anno = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenitore pie__griglia">
    <p class="pie__titolo">L’Antica Via del Cifalco</p>
    <nav aria-label="Collegamenti del piè di pagina">
      <ul>
        <li><a href="/progetto">Il progetto</a></li>
        <li><a href="/itinerario">L’itinerario</a></li>
        <li><a href="/approfondimenti">Approfondimenti</a></li>
        <li><a href="/contatti">Contatti</a></li>
      </ul>
    </nav>
  </div>
  <div class="contenitore pie__nota">
    <p>© {anno} L’Antica Via del Cifalco</p>
  </div>
</footer>

<style>
  .pie {
    background: var(--bosco-scuro);
    color: var(--chiaro);
    padding-block: 2.5rem 1.5rem;
    margin-top: 4rem;
    font-size: 0.97rem;
  }

  .pie__griglia {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1.5rem;
  }

  .pie__titolo {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 650;
    color: var(--chiaro);
    margin: 0;
  }

  .pie ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
  }

  .pie li {
    margin: 0;
  }

  .pie a {
    color: var(--chiaro);
  }
  .pie a:hover {
    color: var(--acqua-chiara);
  }

  .pie__nota {
    border-top: 1px solid rgb(255 255 255 / 0.18);
    padding-top: 1.25rem;
    color: var(--salvia);
  }
</style>
