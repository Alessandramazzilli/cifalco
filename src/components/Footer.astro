---
const anno = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenitore pie__griglia">
    <div>
      <p class="pie__titolo">L’Antica Via del Cifalco</p>
      <p>
        Un cammino di comunità dall’alta Val Trebbia al mare di Portofino,
        sulla strada di muli, commercianti, saltimbanchi e briganti.
      </p>
    </div>
    <nav aria-label="Collegamenti del piè di pagina">
      <p class="pie__titolo">Cammina</p>
      <ul>
        <li><a href="/itinerario">L’itinerario (planner e mappa)</a></li>
        <li><a href="/itinerario/descrizione-dettagliata">Descrizione dettagliata</a></li>
        <li><a href="/itinerario/informazioni-pratiche">Informazioni pratiche</a></li>
      </ul>
    </nav>
    <nav aria-label="Collegamenti di approfondimento">
      <p class="pie__titolo">Scopri</p>
      <ul>
        <li><a href="/progetto">Il progetto</a></li>
        <li><a href="/approfondimenti#voci">Voci d’autore</a></li>
        <li><a href="/approfondimenti#diario">Diario di bordo</a></li>
        <li><a href="/approfondimenti#rete">Una rete di cammini</a></li>
        <li><a href="/dicono-di-noi">Dicono di noi</a></li>
        <li><a href="/chi-siamo">Chi siamo e contatti</a></li>
      </ul>
    </nav>
  </div>
  <div class="contenitore pie__nota">
    <p>
      © {anno} L’Antica Via del Cifalco · Cammina con prudenza: la montagna
      chiede rispetto, non coraggio.
    </p>
  </div>
</footer>

<style>
  .pie {
    background: var(--bosco-scuro);
    color: var(--chiaro);
    padding-block: 2.5rem 1.5rem;
    margin-top: 4rem;
    font-size: 0.97rem;
  }

  .pie__griglia {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    padding-bottom: 2rem;
  }

  .pie__titolo {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 650;
    color: var(--chiaro);
    margin-bottom: 0.6rem;
  }

  .pie ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pie li {
    margin-bottom: 0.4rem;
  }

  .pie a {
    color: var(--chiaro);
  }
  .pie a:hover {
    color: var(--acqua-chiara);
  }

  .pie__nota {
    border-top: 1px solid rgb(255 255 255 / 0.18);
    padding-top: 1.25rem;
    color: var(--salvia);
  }
</style>
