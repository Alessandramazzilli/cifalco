---
/**
 * Nota a margine del quaderno: il modo in cui il sito «protegge» chi cammina.
 * Avvertenze e dritte presentate come annotazioni amichevoli, non come allarmi.
 *
 * Uso: <NotaMargine titolo="Prima di partire">Testo…</NotaMargine>
 * tono="acqua" per le note legate all'acqua.
 */
interface Props {
  titolo?: string;
  tono?: 'terra' | 'acqua';
}
const { titolo = 'Nota a margine', tono = 'terra' } = Astro.props;
---

<aside class:list={['nota', `nota--${tono}`]}>
  <p class="nota__titolo" aria-hidden="true">{titolo}</p>
  <p class="sr-only">{titolo}:</p>
  <div class="nota__testo">
    <slot />
  </div>
</aside>

<style>
  .nota {
    max-width: var(--misura);
    margin-block: 1.5rem;
    padding: 1.1rem 1.35rem 1.1rem 1.5rem;
    border-left: 4px solid var(--terra);
    border-radius: 0 var(--raggio) var(--raggio) 0;
    background: var(--fondo-scuro);
    /* La nota è sempre chiara con testo scuro, anche dentro le bande scure. */
    color: var(--inchiostro);
  }
  .nota :global(a) {
    color: var(--campagna);
  }
  .nota :global(a:hover) {
    color: var(--bosco);
  }
  .nota :global(strong) {
    color: var(--inchiostro);
  }

  .nota--acqua {
    border-left-color: var(--acqua);
    background: var(--acqua-fondo);
  }

  .nota__titolo {
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--terra);
    margin: 0 0 0.4rem;
  }

  .nota--acqua .nota__titolo {
    color: var(--acqua-scura);
  }

  .nota__testo :global(p) {
    margin: 0;
    font-size: 0.99rem;
  }
  .nota__testo :global(p + p) {
    margin-top: 0.5em;
  }
</style>
