---
/**
 * Organizzare il viaggio: il testo, con la mappa GPX in «Mappa e traccia GPX».
 */
import PaginaSezione from '../layouts/PaginaSezione.astro';
import MappaGpx from '../components/MappaGpx.astro';
import { testo, dividi, anteprima } from '../lib/testi';
import { linguaDa, localizza, t } from '../lib/i18n';

const lingua = linguaDa(Astro.url.pathname);
const T = t(lingua);
// Pulsante «Scarica il PDF» accanto al titolo della descrizione dettagliata.
const pulsantePdf = `<a class="bottone bottone--contorno bottone-pdf" href="${localizza('/stampa/descrizione-dettagliata', lingua)}" target="_blank" rel="noopener">${T.pdf.descrizione}</a>`;
const html = testo('fare-il-cammino/organizzare-il-viaggio', lingua).replace(
  /(<h2 id="descrizione-dettagliata">[\s\S]*?<\/h2>)/,
  `<div class="titolo-con-pdf">$1${pulsantePdf}</div>`
);
const [primaDellaMappa, dopoLaMappa] = dividi(html, 'MAPPA-GPX');
---

<PaginaSezione descrizione={anteprima(html, 155)} testo={html}>
  <Fragment set:html={primaDellaMappa} />
  <MappaGpx />
  <Fragment set:html={dopoLaMappa} />
</PaginaSezione>
