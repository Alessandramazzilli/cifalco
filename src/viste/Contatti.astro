---
import Base from '../layouts/Base.astro';
import { EMAIL } from '../lib/menu';
import { fmt, linguaDa, localizza, t } from '../lib/i18n';

const lingua = linguaDa(Astro.url.pathname);
const T = t(lingua);
---

<Base titolo={T.contatti} descrizione={fmt(T.contattiDescrizione, { email: EMAIL })}>
  <section class="sezione">
    <div class="contenitore prosa">
      <p class="occhiello">{T.nomeSito}</p>
      <h1>{T.contatti}</h1>
      <p class="contatti__lead" set:html={fmt(T.contattiTesto, { link: localizza('/chi-siamo#le-persone', lingua) })} />
      <p class="contatti__email">
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .contatti__lead {
    font-size: 1.12rem;
  }
  .contatti__email {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
