---
/** 2. Chi siamo: una sola pagina con le quattro voci (a–d) come capitoli. */
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { sezioni } from '../lib/menu';
import { testo } from '../lib/testi';
import { linguaDa, t } from '../lib/i18n';

const lingua = linguaDa(Astro.url.pathname);
const T = t(lingua);
const sezione = sezioni(lingua).find((s) => s.href.endsWith('/chi-siamo'))!;
const html = testo('chi-siamo/chi-siamo', lingua);
// Ogni capitolo (titolo <h2>) diventa una banda, con colori e foto alternati.
const capitoli = html.split(/(?=<h2 )/).filter((c) => c.includes('<h2 '));
const BANDE = [
  { classe: '', foto: 'muro-ruota-carro.jpg' },
  { classe: 'sezione--bosco', foto: 'faggeta.jpg' },
  { classe: 'sezione--alternata', foto: null },
  { classe: 'sezione--pietra', foto: null },
];
---

<Base titolo={sezione.titolo} descrizione={T.chiSiamoDescrizione}>
  <section class="sezione apertura sezione--bosco">
    <div class="contenitore duo">
      <div>
        <p class="occhiello">{T.nomeSito}</p>
        <h1>{sezione.titolo}</h1>
        <ol class="indice-lettere">
          {
            sezione.voci.map((v) => (
              <li>
                <a href={`#${v.href.split('#')[1]}`}>
                  {v.titolo}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <Foto classe="duo__foto" src="/immagini/home-banner-valle-del-cifalco.jpg" alt={T.altFoto['home-banner-valle-del-cifalco.jpg']} />
    </div>
  </section>

  {
    capitoli.map((c, i) => {
      const banda = BANDE[i % BANDE.length];
      return (
        <section class={`sezione ${banda.classe}`}>
          <div class:list={['contenitore', banda.foto && 'duo duo--alto chi-siamo__duo']}>
            <div class="prosa testo-sito">
              <Fragment set:html={c} />
            </div>
            {banda.foto && <Foto classe="duo__foto chi-siamo__foto" src={`/immagini/${banda.foto}`} alt={T.altFoto[banda.foto]} />}
          </div>
        </section>
      );
    })
  }
</Base>
