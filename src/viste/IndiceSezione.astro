---
/** Pagina d'ingresso di una sezione numerata: le sue voci con le prime righe. */
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { sezioni, SEZIONI } from '../lib/menu';
import { testo, anteprima, nomeTesto } from '../lib/testi';
import { linguaDa, t } from '../lib/i18n';

interface Props {
  href: string; // indirizzo italiano della sezione, es. '/fare-il-cammino'
}
const lingua = linguaDa(Astro.url.pathname);
const T = t(lingua);
const i = SEZIONI.findIndex((s) => s.href === Astro.props.href);
const sezione = sezioni(lingua)[i];
const voci = sezione.voci.map((v) => ({ ...v, anteprima: anteprima(testo(nomeTesto(v.href), lingua)) }));
---

<Base titolo={sezione.titolo} descrizione={`${sezione.titolo}: ${voci.map((v) => v.titolo).join(', ')}.`}>
  <section class={`sezione apertura sezione--${sezione.colore}`}>
    <div class="contenitore duo">
      <div>
        <p class="occhiello">{T.nomeSito}</p>
        <h1 class="apertura__titolo">{sezione.titolo}</h1>
      </div>
      <Foto classe="duo__foto" src={`/immagini/${sezione.foto}`} alt={T.altFoto[sezione.foto]} />
    </div>
  </section>
  <div class="contenitore sezione">
    <ol class="elenco-voci">
      {
        voci.map((v) => (
          <li>
            <a class={`voce-card voce-card--foto voce-card--${sezione.colore}`} href={v.href}>
              <img class="voce-card__foto" src={`/immagini/${v.foto ?? sezione.foto}`} alt="" loading="lazy" decoding="async" />
              <span class="voce-card__corpo">
                <span class="voce-card__titolo">{v.titolo}</span>
                <span class="voce-card__anteprima">{v.anteprima}</span>
                {v.paragrafi && (
                  <span class="voce-card__paragrafi">
                    {v.paragrafi.map((p) => p.titolo).join(' · ')}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>
