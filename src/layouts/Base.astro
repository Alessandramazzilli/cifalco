---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titolo: string;
  descrizione: string;
}

const { titolo, descrizione } = Astro.props;
const titoloCompleto =
  titolo === 'L’Antica Via del Cifalco'
    ? titolo
    : `${titolo} · L’Antica Via del Cifalco`;
const urlCanonico = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={urlCanonico} />
    <link rel="icon" type="image/png" href="/immagini/logo-avc-512.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={urlCanonico} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="L’Antica Via del Cifalco" />
    <meta name="generator" content={Astro.generator} />
    <script>
      if (
        !window.location.pathname.startsWith('/accesso') &&
        localStorage.getItem('cifalco-accesso') !== '1'
      ) {
        window.location.replace('/accesso?da=' + encodeURIComponent(window.location.pathname));
      }
    </script>
  </head>
  <body>
    <a class="salta-al-contenuto" href="#contenuto">Salta al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
