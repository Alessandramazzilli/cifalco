---
/**
 * 1. Home: le citazioni (Morosetti in apertura), «L’Antica Via del Cifalco
 * in breve», le novità e un ingresso a ogni sezione del sito.
 * I testi sono in src/testi/home/.
 */
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { SEZIONI } from '../lib/menu';
import { testo, anteprima, nomeTesto } from '../lib/testi';

const [principale, ...altre] = testo('home/citazioni')
  .split('\n')
  .filter((r) => r.startsWith('<figure'));

// Un ingresso per sezione, con le prime righe della sua prima voce.
const ingressi = SEZIONI.filter((s) => s.voci.length > 0).map((s) => {
  const primo = s.href === '/chi-siamo' ? 'chi-siamo/chi-siamo' : nomeTesto(s.voci[0].href);
  return { ...s, anteprima: anteprima(testo(primo), 230) };
});
---

<Base
  titolo="L’Antica Via del Cifalco"
  descrizione="L’Antica Via del Cifalco: una mulattiera medievale riscoperta, da Ponte Organasco a Portofino Mare in circa 75 chilometri lungo il crinale tra Trebbia e Aveto."
>
  <section class="sezione sezione--pietra">
    <div class="contenitore duo">
      <div>
        <p class="occhiello">Da Ponte Organasco a Portofino Mare</p>
        <h1 class="home__titolo">L’Antica Via del Cifalco</h1>
        <Fragment set:html={principale} />
      </div>
      <Foto
        classe="duo__foto"
        src="/immagini/home-banner-valle-del-cifalco.jpg"
        alt="La valle del Cifalco vista dall’alto, con un borgo tra i boschi"
      />
    </div>
  </section>

  <section class="sezione home__citazioni" aria-label="Citazioni">
    <div class="contenitore home__citazioni-griglia">
      <Fragment set:html={altre.join('\n')} />
    </div>
  </section>

  <section class="sezione sezione--alternata">
    <div class="contenitore duo duo--alto">
      <div class="testo-sito home__elenco">
        <h2>L’Antica Via del Cifalco in breve</h2>
        <Fragment set:html={testo('home/in-breve')} />
      </div>
      <div class="testo-sito home__elenco home__novita">
        <h2>Novità</h2>
        <Fragment set:html={testo('home/novita')} />
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <h2>Scopri il sito</h2>
      <ol class="elenco-voci elenco-voci--sezioni">
        {
          ingressi.map((s) => (
            <li>
              <a class="voce-card card" href={s.href}>
                <span class="voce-card__corpo">
                  <span class="voce-card__titolo">{s.titolo}</span>
                  <span class="voce-card__anteprima">{s.anteprima}</span>
                  <span class="voce-card__paragrafi">
                    {s.voci.map((v) => `${v.lettera}. ${v.titolo}`).join(' · ')}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
