---
import Base from '../layouts/Base.astro';
import CardItinerario from '../components/CardItinerario.astro';
import Foto from '../components/Foto.astro';
import { caricaPercorso, formattaOre } from '../lib/percorso';

const percorso = await caricaPercorso();

const viaIntera = percorso.itinerari.find((i) => i.id === 'via-intera')!;
const tappeVia = viaIntera.tappe.map(
  (id) => percorso.tappe.find((t) => t.id === id)!
);
const distanzaTotale = tappeVia.reduce((s, t) => s + t.distanzaKm, 0);
const oreTotali = tappeVia.reduce((s, t) => s + t.oreBase, 0);
---

<Base
  titolo="L’Antica Via del Cifalco"
  descrizione="Dall’alta Val Trebbia al mare di Portofino, a piedi: un cammino di più giorni tra crinali, faggete, passi e borghi. Itinerari, walk planner e mappa illustrata."
>
  <!-- Hero: banda verde, testo a sinistra e foto intera a destra -->
  <section class="sezione sezione--bosco">
    <div class="contenitore duo">
      <div>
        <p class="occhiello">Un cammino di comunità</p>
        <h1>Dalla Val Trebbia al mare, sulla strada dei muli</h1>
        <p class="hero__intro">
          Otto tratte a piedi tra crinali, faggete, passi e borghi, sulla rete
          di sentieri che muli, commercianti, saltimbanchi e briganti hanno
          battuto per secoli.
        </p>
        <a class="bottone bottone--pieno" href="/itinerario">Apri l’itinerario</a>
      </div>
      <Foto
        classe="duo__foto"
        src="/immagini/home-banner-valle-del-cifalco.jpg"
        alt="La valle del Cifalco vista dall’alto, con un borgo tra i boschi"
      />
    </div>
  </section>

  <!-- Lo sguardo d'insieme, in numeri (nessun link) -->
  <section class="sezione">
    <div class="contenitore">
      <dl class="snapshot">
        <div class="dato">
          <dt>Lunghezza</dt>
          <dd>{distanzaTotale.toLocaleString('it-IT', { maximumFractionDigits: 0 })} km</dd>
        </div>
        <div class="dato">
          <dt>Tratte</dt>
          <dd>{tappeVia.length}</dd>
        </div>
        <div class="dato">
          <dt>Tempo di cammino</dt>
          <dd>{formattaOre(oreTotali)}</dd>
        </div>
        <div class="dato">
          <dt>Da</dt>
          <dd>Ponte Organasco</dd>
        </div>
        <div class="dato">
          <dt>A</dt>
          <dd>Portofino mare</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- I tre itinerari: il cuore della home -->
  <section class="sezione sezione--alternata">
    <div class="contenitore">
      <p class="occhiello">Scegli il tuo passo</p>
      <h2>Tre modi di camminare la Via</h2>
      <p class="testo-largo">
        Non serve farla tutta: la Via si lascia camminare anche a metà giornata.
        Scegli un itinerario e il <a href="/itinerario">planner</a> lo costruisce
        sul tempo e sulle gambe che hai.
      </p>
      <div class="griglia" style="margin-top: 1.5rem;">
        {
          percorso.itinerari.map((itinerario) => (
            <CardItinerario itinerario={itinerario} percorso={percorso} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Dalla valle al mare: banda acqua + foto della costa -->
  <section class="sezione sezione--acqua">
    <div class="contenitore duo duo--foto-prima">
      <div>
        <p class="occhiello">Il filo dell’acqua</p>
        <h2>Dalle fonti del crinale al Mar Ligure</h2>
        <p>
          La Via è scandita dall’acqua: la fontana del trivio a Ponte Organasco,
          le sorgive verso Casanova, i guadi dell’Aveto, fino all’acqua che
          chiude il cammino, quella del mare di Portofino.
        </p>
        <a class="bottone bottone--contorno" href="/itinerario#acqua">
          I punti acqua della Via
        </a>
      </div>
      <Foto
        classe="duo__foto"
        src="/immagini/costa-tigullio.jpg"
        alt="Il golfo del Tigullio visto dall’alto, dove la Via arriva al mare"
      />
    </div>
  </section>

  <!-- Chiusura: banda terra, una sola porta verso il racconto -->
  <section class="sezione sezione--terra">
    <div class="contenitore">
      <p class="occhiello">Più di un sentiero</p>
      <h2>Muli, fiere, briganti e faggete</h2>
      <p class="testo-largo">
        La Via è anche una storia di lavoro e di comunità, raccontata con
        rigore: i documenti da una parte, le leggende dall’altra.
      </p>
      <a class="bottone bottone--pieno" href="/approfondimenti">
        Leggi gli approfondimenti
      </a>
    </div>
  </section>
</Base>

<style>
  .hero__intro {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
  }

  .snapshot {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 3rem;
    margin: 0;
  }

  .testo-largo {
    max-width: var(--misura);
    font-size: 1.08rem;
  }
</style>
