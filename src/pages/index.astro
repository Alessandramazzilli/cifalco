---
import Base from '../layouts/Base.astro';
import Illustrazione from '../components/Illustrazione.astro';
import CardItinerario from '../components/CardItinerario.astro';
import NotaMargine from '../components/NotaMargine.astro';
import { caricaPercorso } from '../lib/percorso';
import { getCollection } from 'astro:content';

const percorso = await caricaPercorso();
const articoli = (await getCollection('articoli'))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);
---

<Base
  titolo="L’Antica Via del Cifalco"
  descrizione="Dall’alta Val Trebbia al mare di Portofino, a piedi: l’Antica Via del Cifalco è un cammino di più giorni tra crinali, faggete, passi e borghi. Itinerari, walk planner e mappa illustrata."
>
  <!-- Hero -->
  <section class="hero">
    <div class="contenitore hero__griglia">
      <div class="hero__testo">
        <p class="occhiello">Un cammino di comunità</p>
        <h1>Dalla Val Trebbia al mare, sulla strada dei muli</h1>
        <p class="hero__sottotitolo">
          L’Antica Via del Cifalco unisce l’Appennino dell’alta Val Trebbia al
          mare di Portofino: otto tratte tra crinali, faggete, passi e borghi,
          sulla rete di sentieri che muli, commercianti, saltimbanchi e
          briganti hanno battuto per secoli.
        </p>
        <div class="hero__azioni">
          <a class="bottone bottone--pieno" href="/itinerario#pianifica">
            Pianifica la camminata
          </a>
          <a class="bottone bottone--contorno" href="/itinerario#mappa">
            Guarda la mappa
          </a>
        </div>
      </div>
      <Illustrazione
        scena="colline"
        alt="Il sentiero della Via del Cifalco corre sul crinale appenninico verso il mare"
        nomeFile="home-hero-via-del-cifalco.jpg"
        rapporto="4/3"
      />
    </div>
  </section>

  <!-- I tre richiami -->
  <section class="sezione sezione--alternata">
    <div class="contenitore">
      <div class="griglia">
        <article class="richiamo">
          <h2 class="richiamo__titolo">Cammina</h2>
          <p>
            Tre itinerari sul filo della Via: la traversata intera in 4–5
            giorni, i crinali dell’alta Val Trebbia, la discesa dal crinale al
            mare. Tempi, segnavia e acqua spiegati in modo che non ci si possa
            perdere.
          </p>
          <a href="/itinerario">Vai all’itinerario →</a>
        </article>
        <article class="richiamo">
          <h2 class="richiamo__titolo">Scopri il territorio</h2>
          <p>
            Borghi d’alta valle, rifugi di crinale, la vista che dal Caucaso
            abbraccia l’Appennino e il Tigullio. Il cammino è anche quello che
            trovi quando ti fermi.
          </p>
          <a href="/itinerario#mappa">Esplora la mappa →</a>
        </article>
        <article class="richiamo">
          <h2 class="richiamo__titolo">La storia</h2>
          <p>
            Vie del sale, mulattieri, fiere e briganti, raccontati con affetto
            e con rigore: i documenti da una parte, le leggende dall’altra.
          </p>
          <a href="/approfondimenti">Gli approfondimenti →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Gli itinerari -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Scegli il tuo passo</p>
      <h2>Tre modi di camminare la Via</h2>
      <p>
        Non serve fare tutto e subito: la Via si lascia camminare anche a
        metà. Questi sono i tre tagli classici; il
        <a href="/itinerario#pianifica">planner</a> li cuce sul tempo e sulle
        gambe che hai.
      </p>
      <div class="griglia" style="margin-top: 1.5rem;">
        {
          percorso.itinerari.map((itinerario) => (
            <CardItinerario itinerario={itinerario} percorso={percorso} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Il filo dell'acqua -->
  <section class="sezione sezione--bosco">
    <div class="contenitore home-acqua">
      <div>
        <p class="occhiello">Il filo dell’acqua</p>
        <h2>Dalle fonti del crinale al Mar Ligure</h2>
        <p>
          La Via è scandita dall’acqua: la fontana del trivio a Ponte
          Organasco, la fonte della Casermetta, le sorgive e la Fontana del
          Vino verso Casanova, i guadi dell’Aveto, il Rio dell’Acquapendente —
          fino all’acqua che chiude il cammino, quella del mare di Portofino.
          Nelle schede e nel planner trovi sempre dove riempire le borracce.
        </p>
        <a class="bottone bottone--contorno" href="/itinerario#acqua">
          I punti acqua della Via
        </a>
      </div>
      <Illustrazione
        scena="fonte"
        alt="Fontana in pietra con abbeveratoio lungo la Via"
        nomeFile="home-fonte-della-via.jpg"
        rapporto="4/3"
      />
    </div>
  </section>

  <!-- Voci del territorio -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Le voci della Via</p>
      <h2>Chi tiene aperta la strada</h2>
      <div class="griglia" style="margin-top: 1.5rem;">
        <blockquote class="voce card">
          <p>
            «I camminatori arrivano stanchi e ripartono che parlano del
            crinale come di un amico. È per quello che teniamo la fontana in
            ordine.»
          </p>
          <footer>
            — Una locandiera dell’alta valle <em>(testo segnaposto)</em>
          </footer>
        </blockquote>
        <blockquote class="voce card">
          <p>
            «Mio nonno portava le some su questi sentieri. Quando ridipingo un
            segnavia mi sembra di salutarlo.»
          </p>
          <footer>
            — Un volontario della Compagnia <em>(testo segnaposto)</em>
          </footer>
        </blockquote>
        <blockquote class="voce card">
          <p>
            «Il giorno che dal Pietrabianca vedi il mare per la prima volta,
            capisci perché questa strada non è mai stata abbandonata davvero.»
          </p>
          <footer>
            — Un camminatore della prima ora <em>(testo segnaposto)</em>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Approfondimenti -->
  <section class="sezione sezione--alternata">
    <div class="contenitore">
      <p class="occhiello">Dal quaderno</p>
      <h2>Storie per il cammino</h2>
      <div class="griglia" style="margin-top: 1.5rem;">
        {
          articoli.map((articolo) => (
            <article class="card anteprima">
              <p class="occhiello">{articolo.data.occhiello}</p>
              <h3>
                <a href={`/approfondimenti/${articolo.id}`}>
                  {articolo.data.titolo}
                </a>
              </h3>
              <p>{articolo.data.estratto}</p>
            </article>
          ))
        }
      </div>
      <NotaMargine titolo="Prima di partire">
        <p>
          La Via è descritta con cura, ma resta un cammino di montagna: guarda
          le previsioni, parti con l’acqua piena e di’ a qualcuno dove vai.
          Tutto il resto è nelle
          <a href="/itinerario/informazioni-pratiche">informazioni pratiche</a>.
        </p>
      </NotaMargine>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  .hero__griglia {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
  }

  @media (max-width: 56rem) {
    .hero__griglia {
      grid-template-columns: 1fr;
    }
  }

  .hero__sottotitolo {
    font-size: 1.15rem;
    color: var(--inchiostro-tenue);
  }

  .hero__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .richiamo__titolo {
    font-size: 1.45rem;
  }

  .richiamo a {
    font-weight: 650;
  }

  .home-acqua {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
  }

  @media (max-width: 56rem) {
    .home-acqua {
      grid-template-columns: 1fr;
    }
  }

  .home-acqua .bottone {
    margin-top: 0.5rem;
  }

  .voce {
    margin: 0;
    font-family: var(--serif);
  }

  .voce p {
    font-size: 1.08rem;
    margin-bottom: 0.75rem;
  }

  .voce footer {
    font-family: var(--sans);
    font-size: 0.92rem;
    color: var(--inchiostro-tenue);
  }

  .anteprima h3 {
    font-size: 1.2rem;
  }

  .anteprima h3 a {
    color: var(--bosco-scuro);
    text-decoration: none;
  }

  .anteprima h3 a:hover {
    text-decoration: underline;
  }
</style>
