---
import Base from '../layouts/Base.astro';
import IconaPunto from '../components/IconaPunto.astro';
import NotaMargine from '../components/NotaMargine.astro';
import { caricaPercorso, ETICHETTE_TIPO } from '../lib/percorso';

const percorso = await caricaPercorso();

// I punti raccontati nell'ordine del cammino (senso classico), non a griglia:
// l'ordine è quello in cui li incontri.
const ordineCammino = [
  'borgo-pietrafonte',
  'lavatoio-vecchio',
  'fonte-del-mulattiere',
  'ponte-dei-saltimbanchi',
  'casale-dell-orso',
  'faggeta-di-colle-alto',
  'valico-delle-tre-querce',
  'fonte-del-brigante',
  'san-lorenzo-in-colle',
  'fonte-vecchia',
  'eremo-di-sant-onorio',
  'rocca-del-cifalco',
];
const punti = ordineCammino.map(
  (id) => percorso.punti.find((p) => p.id === id)!
);
---

<Base
  titolo="Punti d’interesse"
  descrizione="Borghi, fonti, valichi e luoghi del racconto lungo la Via del Cifalco, nell’ordine in cui li incontri camminando."
>
  <div class="contenitore sezione">
    <p class="occhiello">Punti d’interesse</p>
    <h1>Quello che incontri, nell’ordine in cui lo incontri</h1>
    <p style="font-size: 1.12rem;">
      Non un catalogo, ma il racconto della strada: i luoghi della Via uno
      dopo l’altro, da Pietrafonte alla Rocca, come li vede chi cammina nel
      senso classico.
    </p>

    <ol class="cammino">
      {
        punti.map((punto) => (
          <li class:list={['cammino__punto', `cammino__punto--${punto.tipo}`]}>
            <span class="cammino__icona" aria-hidden="true">
              <IconaPunto tipo={punto.tipo} dimensione={20} />
            </span>
            <div class="cammino__scheda">
              <p class="occhiello">
                {ETICHETTE_TIPO[punto.tipo]}
                {punto.quota ? ` · ${punto.quota} m s.l.m.` : ''}
              </p>
              <h2>{punto.nome}</h2>
              <p>{punto.descrizione}</p>
              {punto.acquaPotabile && (
                <p class="acqua-punto">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 3 C 12 3 6 10.5 6 14.5 C 6 18 8.7 20.5 12 20.5 C 15.3 20.5 18 18 18 14.5 C 18 10.5 12 3 12 3 Z" />
                  </svg>
                  Qui c’è acqua potabile
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <NotaMargine>
      <p>
        Vuoi vedere dove sono? Tutti questi punti sono sulla
        <a href="/mappa">mappa illustrata</a>, con le stesse schede.
      </p>
    </NotaMargine>
  </div>
</Base>

<style>
  .cammino {
    list-style: none;
    margin: 2.5rem 0;
    padding: 0;
    position: relative;
  }

  /* Il filo del sentiero che cuce i punti */
  .cammino::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 1.5rem;
    bottom: 1.5rem;
    border-left: 3px dashed var(--tortora);
  }

  .cammino__punto {
    position: relative;
    display: flex;
    gap: 1.25rem;
    padding: 0 0 2.25rem 0;
  }

  .cammino__icona {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--carta);
    border: 2px solid var(--umbra);
    color: var(--umbra);
    box-shadow: var(--ombra);
  }

  .cammino__punto--fonte .cammino__icona { border-color: var(--acqua); color: var(--acqua); }
  .cammino__punto--borgo .cammino__icona { border-color: var(--bosco); color: var(--bosco); }
  .cammino__punto--valico .cammino__icona { border-color: var(--pietra); color: var(--pietra); }
  .cammino__punto--natura .cammino__icona { border-color: var(--campagna); color: var(--campagna); }

  .cammino__scheda h2 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }

  .cammino__scheda p:last-child {
    margin-bottom: 0;
  }
</style>
