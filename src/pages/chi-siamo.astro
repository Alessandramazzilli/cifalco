---
/**
 * 2. Chi siamo: una sola pagina con le quattro voci (a–d) come capitoli.
 * Il testo è in src/testi/chi-siamo/chi-siamo.html.
 */
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { SEZIONI } from '../lib/menu';
import { testo } from '../lib/testi';

const sezione = SEZIONI.find((s) => s.href === '/chi-siamo')!;
// Ogni titolo <h2> riceve la sua lettera, come nello schema.
let html = testo('chi-siamo/chi-siamo');
for (const voce of sezione.voci) {
  const id = voce.href.split('#')[1];
  html = html.replace(
    `<h2 id="${id}">`,
    `<h2 id="${id}" class="titolo-voce"><span class="titolo-voce__lettera">${voce.lettera}.</span> `
  );
}
---

<Base
  titolo="Chi siamo"
  descrizione="Il progetto dell’Antica Via del Cifalco, le persone che lo animano, i ringraziamenti e la menzione legale."
>
  <section class="sezione sezione--pietra">
    <div class="contenitore duo">
      <div>
        <p class="occhiello">L’Antica Via del Cifalco</p>
        <h1>Chi siamo</h1>
        <ol class="indice-lettere">
          {
            sezione.voci.map((v) => (
              <li>
                <a href={v.href.replace('/chi-siamo', '')}>
                  <span class="indice-sezione__lettera">{v.lettera}.</span> {v.titolo}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <Foto classe="duo__foto" src="/immagini/faggeta.jpg" alt="Una faggeta lungo il crinale della Via" />
    </div>
  </section>

  <div class="contenitore sezione">
    <div class="prosa testo-sito">
      <Fragment set:html={html} />
    </div>
  </div>
</Base>
