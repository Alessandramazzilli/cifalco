---
import Base from '../layouts/Base.astro';
import { EMAIL } from '../lib/menu';
---

<Base
  titolo="Contatti"
  descrizione={`Per scrivere all’Antica Via del Cifalco: ${EMAIL}.`}
>
  <section class="sezione">
    <div class="contenitore prosa">
      <p class="occhiello">L’Antica Via del Cifalco</p>
      <h1>Contatti</h1>
      <p class="contatti__lead">
        Per informazioni sul cammino, segnalazioni dal sentiero, proposte di
        collaborazione o per entrare a far parte della
        <a href="/chi-siamo#le-persone">Compagnia del Cifalco</a>, scriveteci:
      </p>
      <p class="contatti__email">
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .contatti__lead {
    font-size: 1.12rem;
  }
  .contatti__email {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
