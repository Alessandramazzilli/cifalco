---
import Base from '../layouts/Base.astro';
---

<Base
  titolo="Contatti"
  descrizione="Come contattare la Compagnia del Cifalco: informazioni sul percorso, segnalazioni dal sentiero, contributi e collaborazioni."
>
  <section class="sezione sezione--bosco">
    <div class="contenitore">
      <p class="occhiello">Contatti</p>
      <h1>Scriviamoci</h1>
      <p class="lead">
        Per informazioni sul percorso, segnalazioni dal sentiero, contributi
        agli approfondimenti o collaborazioni tra cammini: siamo qui.
        <em>(I recapiti sono segnaposto, in attesa di quelli definitivi.)</em>
      </p>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <div class="griglia">
        <article class="card recapito">
          <h2>Posta elettronica</h2>
          <p>Per qualsiasi domanda o proposta, il modo più semplice.</p>
          <p>
            <a href="mailto:info@anticaviadelcifalco.it">info@anticaviadelcifalco.it</a>
            <em>(segnaposto)</em>
          </p>
        </article>
        <article class="card recapito">
          <h2>Telefono</h2>
          <p>Per informazioni veloci, negli orari di ufficio.</p>
          <p><strong>000 0000000</strong> <em>(segnaposto)</em></p>
        </article>
        <article class="card recapito">
          <h2>Chi c’è dietro</h2>
          <p>Le persone della Via e come dare una mano.</p>
          <p>
            <a href="/progetto#t-compagnia">La Compagnia del Cifalco</a>
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .lead {
    font-size: 1.12rem;
    max-width: var(--misura);
    margin-bottom: 0;
  }
  .recapito h2 {
    font-size: 1.2rem;
  }
  .recapito p:last-child {
    margin-bottom: 0;
  }
</style>
