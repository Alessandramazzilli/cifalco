---
// Pagina di accesso con password. Per cambiare la password modifica la riga qui sotto.
const PASSWORD = 'Revisione123!';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Accesso · L'Antica Via del Cifalco</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      @import url('/src/styles/global.css');

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Source Sans 3', system-ui, sans-serif;
        background: #2d4a2d;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }

      .scheda {
        background: #fff;
        border-radius: 1rem;
        padding: 2.5rem 2rem;
        max-width: 22rem;
        width: 100%;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,.18);
      }

      .logo {
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: #2d4a2d;
        margin-bottom: 0.25rem;
        letter-spacing: .01em;
      }

      .sottotitolo {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 2rem;
      }

      label {
        display: block;
        text-align: left;
        font-size: 0.88rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.4rem;
      }

      input[type="password"] {
        width: 100%;
        padding: 0.6rem 0.85rem;
        border: 1.5px solid #ccc;
        border-radius: 0.5rem;
        font-size: 1rem;
        outline: none;
        transition: border-color .15s;
      }

      input[type="password"]:focus {
        border-color: #2d4a2d;
      }

      .errore {
        color: #c0392b;
        font-size: 0.85rem;
        margin-top: 0.5rem;
        min-height: 1.2em;
        text-align: left;
      }

      button {
        margin-top: 1.25rem;
        width: 100%;
        padding: 0.7rem;
        background: #2d4a2d;
        color: #fff;
        border: none;
        border-radius: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
      }

      button:hover { background: #1e3320; }
    </style>
  </head>
  <body>
    <div class="scheda">
      <p class="logo">L'Antica Via del Cifalco</p>
      <p class="sottotitolo">Sito in anteprima — accesso riservato</p>
      <form id="form">
        <label for="pw">Password</label>
        <input id="pw" type="password" autocomplete="current-password" autofocus />
        <p class="errore" id="errore" aria-live="polite"></p>
        <button type="submit">Entra</button>
      </form>
    </div>

    <script define:vars={{ PASSWORD }}>
      const form = document.getElementById('form');
      const pw = document.getElementById('pw');
      const errore = document.getElementById('errore');

      // Se già autenticato, vai alla home
      if (localStorage.getItem('cifalco-accesso') === '1') {
        const params = new URLSearchParams(window.location.search);
        window.location.replace(params.get('da') || '/');
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (pw.value === PASSWORD) {
          localStorage.setItem('cifalco-accesso', '1');
          const params = new URLSearchParams(window.location.search);
          window.location.replace(params.get('da') || '/');
        } else {
          errore.textContent = 'Password non corretta.';
          pw.value = '';
          pw.focus();
        }
      });
    </script>
  </body>
</html>
