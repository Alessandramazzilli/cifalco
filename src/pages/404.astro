---
import Base from '../layouts/Base.astro';
---

<Base
  titolo="Pagina non trovata"
  descrizione="La pagina che cerchi non esiste: torna all’ultimo segnavia."
>
  <div class="contenitore sezione" style="text-align: center;">
    <p class="occhiello">Errore 404</p>
    <h1>Ti sei allontanato dal sentiero</h1>
    <p style="margin-inline: auto;">
      Questa pagina non esiste. Vale la regola della Via: torna all’ultimo
      segnavia che hai visto e riparti da lì.
    </p>
    <p style="margin-top: 1.5rem;">
      <a class="bottone bottone--pieno" href="/">Torna alla partenza</a>
    </p>
  </div>
</Base>
